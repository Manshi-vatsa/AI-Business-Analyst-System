package com.ai.analytics.controller;

import org.springframework.http.*;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.client.RestTemplate;
import org.springframework.beans.factory.annotation.Autowired;
import com.ai.analytics.service.DashboardService;
import com.ai.analytics.model.DashboardData;
import com.ai.analytics.dto.ApiResponse;
import com.ai.analytics.exception.ServiceUnavailableException;
import com.ai.analytics.exception.BusinessException;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.util.HashMap;
import java.util.Map;

@RestController
@RequestMapping("/api")
@CrossOrigin(origins = "*")
public class QueryController {
    
    private static final Logger logger = LoggerFactory.getLogger(QueryController.class);
    
    private final RestTemplate restTemplate;
    private final DashboardService dashboardService;
    
    @Autowired
    public QueryController(RestTemplate restTemplate, DashboardService dashboardService) {
        this.restTemplate = restTemplate;
        this.dashboardService = dashboardService;
    }
    
    // POST /api/query - Process natural language queries by calling Python API
    @PostMapping("/query")
    public ApiResponse<Map<String, Object>> processQuery(@RequestBody Map<String, String> request) {
        logger.info("Processing query request: {}", request.get("question"));
        
        String question = request.get("question");
        
        if (question == null || question.trim().isEmpty()) {
            logger.warn("Empty question received in query request");
            throw new BusinessException("Question is required");
        }
        
        try {
            // Prepare request to Python API
            String pythonApiUrl = "http://localhost:8000/ai/query";
            
            // Create request body for Python API
            Map<String, String> pythonRequest = new HashMap<>();
            pythonRequest.put("question", question);
            
            // Set headers
            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.APPLICATION_JSON);
            
            // Create HTTP entity
            HttpEntity<Map<String, String>> entity = new HttpEntity<>(pythonRequest, headers);
            
            // Call Python API
            logger.debug("Calling Python API at: {}", pythonApiUrl);
            ResponseEntity<Object> pythonResponse = restTemplate.postForEntity(pythonApiUrl, entity, Object.class);
            
            if (pythonResponse.getStatusCode() == HttpStatus.OK) {
                // Return the response from Python API
                Object responseBody = pythonResponse.getBody();
                if (responseBody instanceof Map) {
                    logger.info("Successfully processed query");
                    return ApiResponse.success((Map<String, Object>) responseBody, "Query processed successfully");
                } else {
                    logger.error("Invalid response format from Python API");
                    throw new BusinessException("Invalid response format from Python API");
                }
            } else {
                logger.error("Python API call failed with status: {}", pythonResponse.getStatusCode());
                throw new BusinessException("Python API call failed with status: " + pythonResponse.getStatusCode());
            }
            
        } catch (org.springframework.web.client.ResourceAccessException e) {
            logger.error("Python AI service unavailable: {}", e.getMessage());
            throw new ServiceUnavailableException("Python AI service is currently unavailable. Please try again later.");
        } catch (org.springframework.web.client.HttpServerErrorException e) {
            logger.error("Python AI service error: {}", e.getResponseBodyAsString());
            throw new ServiceUnavailableException("Python AI service error: " + e.getResponseBodyAsString());
        } catch (BusinessException | ServiceUnavailableException e) {
            throw e; // Re-throw our custom exceptions
        } catch (Exception e) {
            logger.error("Unexpected error processing query: {}", e.getMessage(), e);
            throw new BusinessException("Internal server error while processing query");
        }
    }
    
    // GET /api/dashboard - Get analytics dashboard data
    @GetMapping("/dashboard")
    public ApiResponse<DashboardData> getDashboardData() {
        logger.info("Fetching dashboard data");
        
        try {
            DashboardData dashboardData = dashboardService.getDashboardData();
            logger.info("Successfully retrieved dashboard data");
            return ApiResponse.success(dashboardData, "Dashboard data retrieved successfully");
        } catch (Exception e) {
            logger.error("Error retrieving dashboard data: {}", e.getMessage(), e);
            throw new BusinessException("Failed to retrieve dashboard data");
        }
    }
}
